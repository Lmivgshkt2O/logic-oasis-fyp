rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function createsStudentProfile(userId) {
      return ownsUserDoc(userId) &&
        request.resource.data.role == 'student';
    }

    function keepsStudentAuthorityImmutable(userId) {
      return ownsUserDoc(userId) &&
        resource.data.role == 'student' &&
        request.resource.data.role == 'student' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'parentIds', 'linkedParentAccountId', 'linkedParentEmail',
          'parentAuthority', 'isActive'
        ]);
    }

    function ownsStudentField() {
      return signedIn() &&
        request.resource.data.studentId == request.auth.uid;
    }

    function ownsExistingStudentField() {
      return signedIn() &&
        resource.data.studentId == request.auth.uid;
    }

    function isStudent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // U8 exposes only bounded derived projections.  Link creation/revocation
    // is owned by the U9 callable administration flow; this predicate merely
    // enforces a server-created active relationship when it exists.
    function isActiveLinkedParent(studentId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentId)) &&
        get(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentId)).data.status == 'active' &&
        get(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentId)).data.parentId == request.auth.uid &&
        get(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentId)).data.studentId == studentId;
    }

    function ownsOrActiveLinkedParent(studentId) {
      return signedIn() && (request.auth.uid == studentId || isActiveLinkedParent(studentId));
    }

    function ownsStatusSourceAttempt(attemptId) {
      return exists(/databases/$(database)/documents/quizAttempts/$(attemptId)) &&
        ownsOrActiveLinkedParent(
          get(/databases/$(database)/documents/quizAttempts/$(attemptId)).data.studentId
        );
    }

    match /topics/{topicId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /questionBanks/{bankId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Correctness and explanations are server-only. Callable quiz-session
    // functions use the Admin SDK and are not constrained by these rules.
    match /questionAnswerKeys/{questionId} {
      allow read, write: if false;
    }

    // U15 material provenance, content digests, locators, and reviewer
    // identities are server-only approval records. Clients may read only the
    // approved active projection in `questions`.
    match /contentSourceManifest/{materialId} {
      allow read, write: if false;
    }

    // U3 session and response documents are created and finalized only by
    // callable Functions through the Admin SDK. The app receives safe return
    // payloads, not direct document access.
    match /quizSessions/{sessionId} {
      allow read, write: if false;
    }

    match /questionResponses/{responseId} {
      allow read, write: if false;
    }

    // U3-R's monotonic sequence is allocated by the callable finalization
    // transaction only. It must never become a client or parent data source.
    match /studentSubtopicSequenceStates/{studentId}/subtopics/{subtopicId} {
      allow read, write: if false;
    }

    match /subtopics/{subtopicId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{userId} {
      // Students create only their own student profile. Parent profiles are
      // created by the U12 callable after verified invitation consent; neither
      // role nor parent-authority fields are client-editable.
      allow read: if ownsUserDoc(userId);
      allow create: if createsStudentProfile(userId);
      allow update: if keepsStudentAuthorityImmutable(userId);
      allow delete: if false;
    }

    match /rememberedProfiles/{profileId} {
      allow read, write: if ownsUserDoc(profileId);
    }

    match /parentAccounts/{parentId} {
      // Superseded prototype records included password-derived data. U9 uses
      // Firebase Auth plus the server-owned parentLinks relationship instead.
      allow read, write: if false;
    }

    match /quizAttempts/{attemptId} {
      allow read: if ownsExistingStudentField();
      allow write: if false;
    }

    match /topicMastery/{masteryId} {
      allow read: if ownsExistingStudentField();
      allow write: if false;
    }

    match /subtopicMastery/{masteryId} {
      allow read: if ownsOrActiveLinkedParent(resource.data.studentId);
      allow write: if false;
    }

    match /studentAiStatuses/{attemptId} {
      // A result page can subscribe after quiz finalization but before the AI
      // trigger creates this projection. Authorize that missing-document read
      // through the immutable, server-owned source attempt; once the projection
      // exists, retain the normal bounded-projection ownership check.
      allow read: if resource == null
        ? ownsStatusSourceAttempt(attemptId)
        : ownsOrActiveLinkedParent(resource.data.studentId);
      allow write: if false;
    }

    match /adaptiveAssignments/{assignmentId} {
      allow read: if ownsOrActiveLinkedParent(resource.data.studentId);
      allow write: if false;
    }

    // U10 will own this deliberately count-only projection. U9 reserves the
    // safe read surface now; forum text, identities and moderation data have
    // no client-readable rule.
    match /forumParticipationSummaries/{studentId} {
      allow read: if ownsOrActiveLinkedParent(studentId);
      allow write: if false;
    }

    // U10's peer forum is a student-only surface.  Parents read only the
    // count-only summary above, never posts, identities, moderation, AI jobs,
    // or AI runs.  Server triggers/callables stamp derived state using Admin.
    match /forumQuestions/{questionId} {
      allow read: if isStudent();
      allow create: if isStudent() &&
        request.resource.data.keys().hasOnly([
          'authorId', 'title', 'text', 'createdAt', 'updatedAt'
        ]) && request.resource.data.authorId == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() >= 8 &&
        request.resource.data.title.size() <= 140 &&
        request.resource.data.text is string && request.resource.data.text.size() >= 20 &&
        request.resource.data.text.size() <= 3000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isStudent() && resource.data.authorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'text', 'updatedAt'
        ]) && request.resource.data.title is string &&
        request.resource.data.title.size() >= 8 && request.resource.data.title.size() <= 140 &&
        request.resource.data.text is string && request.resource.data.text.size() >= 20 &&
        request.resource.data.text.size() <= 3000 && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /forumAnswers/{answerId} {
      allow read: if isStudent();
      allow create: if isStudent() &&
        request.resource.data.keys().hasOnly([
          'questionId', 'authorId', 'text', 'createdAt', 'updatedAt', 'revision'
        ]) && request.resource.data.authorId == request.auth.uid &&
        request.resource.data.questionId is string &&
        exists(/databases/$(database)/documents/forumQuestions/$(request.resource.data.questionId)) &&
        request.resource.data.text is string && request.resource.data.text.size() >= 8 &&
        request.resource.data.text.size() <= 4000 &&
        request.resource.data.get('revision', 1) == 1 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      // A learner may revise only their text. AI feedback and acceptance are
      // server-owned fields and cannot be forged from Flutter.
      allow update: if isStudent() && resource.data.authorId == request.auth.uid &&
        resource.data.get('acceptedAt', null) == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text', 'updatedAt', 'revision', 'aiFeedback'
        ]) && request.resource.data.text is string &&
        request.resource.data.text.size() >= 8 && request.resource.data.text.size() <= 4000 &&
        request.resource.data.revision == resource.data.get('revision', 1) + 1 &&
        request.resource.data.aiFeedback.keys().hasOnly([
          'state', 'label', 'message', 'revision'
        ]) && request.resource.data.aiFeedback.state == 'pending' &&
        request.resource.data.aiFeedback.label == 'uncertain' &&
        request.resource.data.aiFeedback.message == 'Your revised answer is being reviewed.' &&
        request.resource.data.aiFeedback.revision == request.resource.data.revision &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /forumReports/{reportId} {
      // Reports and review state are server-owned. The callable derives the
      // reporter from verified auth and converges duplicates on this ID.
      allow read, write: if false;
    }

    match /forumBlocks/{blockId} {
      allow create: if isStudent() && request.resource.data.keys().hasOnly([
        'studentId', 'blockedStudentId', 'createdAt'
      ]) && request.resource.data.studentId == request.auth.uid &&
        blockId == request.auth.uid + '_' + request.resource.data.blockedStudentId &&
        request.resource.data.blockedStudentId != request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.blockedStudentId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.blockedStudentId)).data.role == 'student' &&
        request.resource.data.createdAt == request.time;
      allow read, delete: if isStudent() && resource.data.studentId == request.auth.uid;
      allow update: if false;
    }

    match /forumHelpfulMarks/{markId} {
      allow read, write: if false;
    }

    match /forumParticipationEvents/{eventId} {
      allow read, write: if false;
    }

    match /forumAiJobs/{answerId} {
      allow read, write: if false;
    }

    match /forumAiRuns/{answerId} {
      allow read, write: if false;
    }

    match /oasisProgress/{progressId} {
      allow read: if ownsExistingStudentField();
      allow create, update: if ownsStudentField();
      allow delete: if false;
    }

    match /aiModelRuns/{runId} {
      // Includes raw feature values and SHAP arrays; always server-only.
      allow read, write: if false;
    }

    match /aiJobs/{attemptId} {
      allow read, write: if false;
    }

    match /masterySnapshots/{snapshotId} {
      allow read, write: if false;
    }

    match /modelRegistry/{modelId} {
      allow read, write: if false;
    }

    match /parentLinks/{linkId} {
      // Clients cannot establish, reactivate, update, delete, or inspect
      // relationships. U9's audited callable administration flow uses Admin
      // SDK writes and is intentionally outside Rules.
      allow write: if false;
      allow read: if false;
    }

    match /parentLinkInvitations/{invitationId} {
      // Invitation state, email HMACs, verifiers, and delivery evidence are
      // callable-only. Student UI receives a masked callable projection.
      allow read, write: if false;
    }

    match /adminRoleAudits/{auditId} {
      allow read, write: if false;
    }

    match /parentLinkAudits/{auditId} {
      allow read, write: if false;
    }

    // AQC-4 policy-evaluation collections are server-owned. The callable
    // control plane and the U8 runtime use the Admin SDK and are not
    // constrained by these rules; clients are terminally denied even though
    // the default deny rule below would also protect them.
    match /policyEvaluationStudies/{studyVersion} {
      allow read, write: if false;
    }

    match /policyEvaluationConsents/{consentId} {
      allow read, write: if false;
    }

    match /policyEvaluationEnrollments/{enrollmentId} {
      allow read, write: if false;
    }

    match /policyEvaluationAllocationBlocks/{blockId} {
      allow read, write: if false;
    }

    match /policyEvaluationDecisionAudits/{decisionId} {
      allow read, write: if false;
    }

    match /policyEvaluationProbes/{probeId} {
      allow read, write: if false;
    }

    match /policyEvaluationOutcomes/{outcomeId} {
      allow read, write: if false;
    }

    match /policyEvaluationAdminAudits/{auditId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
